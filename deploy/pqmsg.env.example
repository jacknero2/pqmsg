# Copy to /opt/pqmsg/deploy/pqmsg.env and fill in. Loaded by pqmsg.service.
# Never commit the real file — it holds the admin token and (optionally) SMTP creds.

PQMSG_PUBLIC=1
PQMSG_HOST=127.0.0.1
PQMSG_PORT=8787
PQMSG_DATA_DIR=/opt/pqmsg/server-data

# generate with: openssl rand -hex 16 — pin it, or it regenerates if server-data is wiped
PQMSG_ADMIN_TOKEN=

# the https URL Caddy terminates TLS for (see deploy/Caddyfile)
PQMSG_PUBLIC_URL=https://chat.jacknero.com

PQMSG_SERVER_NAME=Jack's Server
PQMSG_SERVER_DESCRIPTION=Server for friends to talk
PQMSG_MASTER_EMAIL=jnero@nd.edu

# Real 2FA emails instead of console dev codes — leave unset to use the dev
# fallback (codes print in `journalctl -u pqmsg`) until you're ready.
#PQMSG_SMTP_HOST=smtp.gmail.com
#PQMSG_SMTP_PORT=587
#PQMSG_SMTP_USER=
#PQMSG_SMTP_PASS=
#PQMSG_SMTP_FROM=

# Most cloud VPS providers (DigitalOcean, Hetzner, etc.) block outbound SMTP
# ports by default as an anti-spam measure — SMTP above will hang/time out
# until their support lifts it for your account. If you don't want to wait on
# that, switch to Resend instead (HTTPS API, port 443, never port-blocked):
#PQMSG_EMAIL_PROVIDER=resend
#PQMSG_RESEND_API_KEY=
#PQMSG_RESEND_FROM=          # must be on a domain verified in your Resend account

# Best-effort error reporting to a GitHub repo you control — opt-in, off by
# default. See shared/diagnostics.js. Uses a fine-grained PAT (Issues: write).
#PQMSG_SEND_DIAGNOSTICS=1
#PQMSG_DIAG_TOKEN=
#PQMSG_DIAG_REPO=jacknero2/pqmsg
