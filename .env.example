# copy to server/.env (or pqmsg/.env) and edit

# --- server ---
PQMSG_PORT=8787
PQMSG_HOST=0.0.0.0
# leave PQMSG_ADMIN_TOKEN empty to restrict the dashboard to localhost;
# set it to allow the dashboard from another machine with ?admin=<token>
PQMSG_ADMIN_TOKEN=

# --- storage backend ---
# local  = server filesystem (default, recommended for testing)
# github = commit every key + encrypted message to a GitHub repo
STORE_BACKEND=local
PQMSG_DATA_DIR=./server-data

# only used when STORE_BACKEND=github
GITHUB_TOKEN=
GITHUB_REPO=your-user/pqmsg-db
GITHUB_BRANCH=main

# --- list this server in the public registry (optional) ---
PQMSG_SERVER_NAME=
PQMSG_SERVER_DESCRIPTION=
PQMSG_PUBLIC_URL=            # the https URL clients actually reach (tunnel / domain)
PQMSG_REGISTRY_URL=          # URL of a running registry service
PQMSG_ANNOUNCE=              # 1 to announce on startup

# --- force client updates (optional) ---
PQMSG_MIN_CLIENT=            # clients older than this are refused at login
PQMSG_LATEST_CLIENT=        # clients older than this get a soft "update available" nag
PQMSG_DOWNLOAD_URL=https://jacknero2.github.io/pqmsg/

# --- email 2FA on login (SMTP; if unset, codes are shown in the server console) ---
PQMSG_SMTP_HOST=
PQMSG_SMTP_PORT=587
PQMSG_SMTP_USER=
PQMSG_SMTP_PASS=            # a mail "app password" for Gmail / Fastmail / etc.
PQMSG_SMTP_FROM=            # defaults to SMTP_USER
PQMSG_SMTP_SECURE=          # 1 for implicit TLS (port 465)
PQMSG_TRUST_DAYS=30        # "remember this device" duration

# --- master registry: this server can also host the directory ---
PQMSG_MASTER_EMAIL=jnero@nd.edu   # who can unlock the built-in registry (2FA'd)

# --- registry service (registry/), if you run one ---
PQMSG_REGISTRY_PORT=8788
PQMSG_REGISTRY_DATA_DIR=./registry-data
PQMSG_REGISTRY_STALE_SEC=300
# PQMSG_REGISTRY_ALLOW_INSECURE=1   # allow http:// server URLs (testing only)
