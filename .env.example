# copy to server/.env (or pqmsg/.env) and edit

# --- server ---
PQMSG_PORT=8787
PQMSG_HOST=0.0.0.0
# set for any internet-facing deployment: disables the "loopback skips the
# admin token" bypass, which is unsafe behind a reverse proxy (every request
# looks like 127.0.0.1 to the server otherwise)
PQMSG_PUBLIC=
# leave PQMSG_ADMIN_TOKEN empty to restrict the dashboard to localhost;
# set it to allow the dashboard from another machine with ?admin=<token>
PQMSG_ADMIN_TOKEN=

# --- storage backend ---
# local  = server filesystem (default, recommended)
# github = commit every key + encrypted message to a GitHub repo
STORE_BACKEND=local
PQMSG_DATA_DIR=./server-data

# only used when STORE_BACKEND=github
GITHUB_TOKEN=
GITHUB_REPO=your-user/pqmsg-db
GITHUB_BRANCH=main

# --- identity shown at /api/serverinfo ---
PQMSG_SERVER_NAME=
PQMSG_SERVER_DESCRIPTION=
PQMSG_PUBLIC_URL=            # the https URL clients actually reach (see DEPLOY.md)

# --- force client updates (optional) ---
PQMSG_MIN_CLIENT=            # clients older than this are refused at login
PQMSG_LATEST_CLIENT=        # clients older than this get a soft "update available" nag
PQMSG_DOWNLOAD_URL=https://jacknero2.github.io/pqmsg/

# --- email 2FA on login (SMTP; if unset, codes are shown in the server console) ---
PQMSG_SMTP_HOST=
PQMSG_SMTP_PORT=587
PQMSG_SMTP_USER=
PQMSG_SMTP_PASS=            # a mail "app password" for Gmail / Fastmail / etc.
PQMSG_SMTP_FROM=            # defaults to SMTP_USER
PQMSG_SMTP_SECURE=          # 1 for implicit TLS (port 465)
PQMSG_TRUST_DAYS=30        # "remember this device" duration

# --- diagnostics: best-effort error reporting to a GitHub repo you control ---
PQMSG_SEND_DIAGNOSTICS=      # 1 to enable (off by default)
PQMSG_DIAG_TOKEN=            # a fine-grained PAT with Issues: write
PQMSG_DIAG_REPO=             # e.g. your-user/pqmsg

# --- read by the client (client/main/engine.js) ---
# PQMSG_SERVER_URL=https://chat.jacknero.com   # override for local dev/testing
