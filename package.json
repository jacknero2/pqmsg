{
  "name": "pqmsg",
  "version": "0.1.0",
  "private": true,
  "description": "Post-quantum end-to-end encrypted messenger (iMessage-style) with an inspectable server console",
  "type": "commonjs",
  "main": "client/main/index.js",
  "author": "jacknero2",
  "homepage": "https://github.com/jacknero2/pqmsg",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacknero2/pqmsg.git"
  },
  "scripts": {
    "server": "node server/src/index.js",
    "server:app": "electron server/app/main.js",
    "client": "electron .",
    "e2e": "node scripts/e2e.js",
    "icon": "node scripts/make-icon.js",
    "dist:client": "electron-builder --config build/client.yml --publish never",
    "dist:server": "electron-builder --config build/server.yml --publish never",
    "dist": "npm run dist:client && npm run dist:server"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/hashes": "^1.7.1",
    "@noble/post-quantum": "^0.4.1",
    "@octokit/rest": "^21.1.1",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
